rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can only read and write its own profile and tasks.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
